<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>RTBI Portal Launcher</title>
<HTA:APPLICATION 
    ID="rtbiPortalLauncher"
    APPLICATIONNAME="RTBI Portal Launcher"
    BORDER="dialog"
    BORDERSTYLE="normal"
    CAPTION="yes"
    ICON=""
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    SELECTION="no"
    CONTEXTMENU="no"
/>
<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        user-select: none;
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #0b1120;
        color: #f1f5f9;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 24px;
    }
    .header {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .logo-badge {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #1e3a8a;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: bold;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    }
    .title-area h1 {
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.3px;
        color: #ffffff;
    }
    .title-area p {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 2px;
    }
    .status-card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 16px 20px;
        margin: 14px 0;
    }
    .status-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    .status-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #64748b;
    }
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .badge-starting {
        background-color: rgba(234, 179, 8, 0.15);
        color: #facc15;
        border: 1px solid rgba(234, 179, 8, 0.3);
    }
    .badge-running {
        background-color: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    .badge-stopped {
        background-color: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
        display: inline-block;
    }
    .dot-starting { background-color: #facc15; }
    .dot-running { background-color: #4ade80; }
    .dot-stopped { background-color: #f87171; }

    .status-message {
        font-size: 13px;
        color: #cbd5e1;
        line-height: 1.4;
        min-height: 36px;
    }
    .info-grid {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #334155;
        font-size: 11.5px;
        color: #94a3b8;
    }
    .info-grid span b {
        color: #e2e8f0;
    }
    .actions {
        display: flex;
        gap: 8px;
        margin-top: 2px;
    }
    button {
        flex: 1;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        outline: none;
        transition: all 0.15s ease;
    }
    .btn-primary {
        background-color: #2563eb;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }
    .btn-primary:hover {
        background-color: #1d4ed8;
    }
    .btn-secondary {
        background-color: #334155;
        color: #e2e8f0;
    }
    .btn-secondary:hover {
        background-color: #475569;
    }
    .btn-danger {
        background-color: #881337;
        color: #fecdd3;
        border: 1px solid #be123c;
    }
    .btn-danger:hover {
        background-color: #be123c;
        color: #ffffff;
    }
    .btn-icon {
        margin-right: 4px;
    }
    .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 11px;
        color: #64748b;
        margin-top: 4px;
    }
    .footer a {
        color: #60a5fa;
        text-decoration: none;
        cursor: pointer;
    }
    .footer a:hover {
        text-decoration: underline;
    }
</style>
</head>
<body onload="init()">

    <div class="header">
        <div class="logo-badge">R</div>
        <div class="title-area">
            <h1>RTBI Portal Launcher</h1>
            <p>Rural Technology & Business Incubator &bull; Local Environment</p>
        </div>
    </div>

    <div class="status-card">
        <div class="status-header">
            <span class="status-label">Portal Status</span>
            <div id="statusBadge" class="badge badge-starting">
                <span id="statusDot" class="indicator-dot dot-starting"></span>
                <span id="badgeText">Initializing</span>
            </div>
        </div>
        <div id="statusMessage" class="status-message">
            Checking environment and local services...
        </div>
        <div class="info-grid">
            <span>URL: <b>http://localhost:3030</b></span>
            <span>Terminal: <b>Hidden (Background)</b></span>
        </div>
    </div>

    <div class="actions">
        <button id="btnOpen" class="btn-primary" onclick="openBrowser()">
            <span class="btn-icon">&#127760;</span> Open App
        </button>
        <button id="btnToggle" class="btn-secondary" onclick="toggleServer()">
            <span class="btn-icon">&#9654;</span> Start Server
        </button>
        <button id="btnWipe" class="btn-danger" style="flex:0.9;" onclick="wipeData()">
            <span class="btn-icon">&#128465;</span> Wipe Data
        </button>
        <button id="btnClose" class="btn-secondary" style="flex:0.5;" onclick="window.close()">
            Close
        </button>
    </div>

    <div class="footer">
        <span>No terminal required</span>
        <a onclick="restartServer()">Restart Service</a>
    </div>

<script>
    var shell = null;
    var fso = null;
    var appDir = "";
    var isRunning = false;
    var pollTimer = null;
    var pollAttempts = 0;
    var maxPollAttempts = 45;
    var browserAlreadyOpened = false;

    function resizeWindow() {
        var w = 550;
        var h = 390;
        window.resizeTo(w, h);
        var left = Math.max(0, (screen.availWidth - w) / 2);
        var top = Math.max(0, (screen.availHeight - h) / 2);
        window.moveTo(left, top);
    }

    function init() {
        try {
            resizeWindow();
        } catch(e) {}

        try {
            shell = new ActiveXObject("WScript.Shell");
            fso = new ActiveXObject("Scripting.FileSystemObject");
            
            var path = unescape(location.pathname);
            if (path.charAt(0) === "/" || path.charAt(0) === "\\") {
                path = path.substring(1);
            }
            appDir = fso.GetParentFolderName(path);

            if (checkHttp()) {
                onServerReady();
                openBrowser();
            } else {
                startServerProcess();
            }
        } catch(err) {
            updateStatus("stopped", "Error initializing launcher: " + err.message);
        }
    }

    function checkHttp() {
        try {
            var xhr = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
            xhr.open("GET", "http://localhost:3030", false);
            xhr.setTimeouts(600, 600, 600, 600);
            xhr.send();
            return (xhr.status > 0);
        } catch(e) {
            return false;
        }
    }

    function updateStatus(state, msg) {
        var badge = document.getElementById("statusBadge");
        var dot = document.getElementById("statusDot");
        var bText = document.getElementById("badgeText");
        var sMsg = document.getElementById("statusMessage");
        var btnToggle = document.getElementById("btnToggle");
        var btnOpen = document.getElementById("btnOpen");

        sMsg.innerText = msg;

        if (state === "running") {
            isRunning = true;
            badge.className = "badge badge-running";
            dot.className = "indicator-dot dot-running";
            bText.innerText = "Online";
            btnToggle.className = "btn-secondary";
            btnToggle.innerHTML = "<span class='btn-icon'>&#9632;</span> Stop Server";
            btnOpen.disabled = false;
            btnOpen.style.opacity = "1";
        } else if (state === "starting") {
            isRunning = false;
            badge.className = "badge badge-starting";
            dot.className = "indicator-dot dot-starting";
            bText.innerText = "Starting...";
            btnToggle.className = "btn-secondary";
            btnToggle.innerHTML = "<span class='btn-icon'>&#8987;</span> Starting...";
            btnOpen.disabled = true;
            btnOpen.style.opacity = "0.6";
        } else {
            isRunning = false;
            badge.className = "badge badge-stopped";
            dot.className = "indicator-dot dot-stopped";
            bText.innerText = "Stopped";
            btnToggle.className = "btn-secondary";
            btnToggle.innerHTML = "<span class='btn-icon'>&#9654;</span> Start Server";
            btnOpen.disabled = true;
            btnOpen.style.opacity = "0.6";
        }
    }

    function startServerProcess() {
        if (!shell) return;
        updateStatus("starting", "Launching Next.js server in the background (no terminal)...");
        pollAttempts = 0;
        browserAlreadyOpened = false;

        try {
            if (!fso.FolderExists(appDir + "\\node_modules")) {
                updateStatus("starting", "First-time setup: Installing dependencies in background. Please wait...");
                var installCmd = 'cmd.exe /c cd /d "' + appDir + '" && npm install';
                shell.Run(installCmd, 0, true);
            }

            var startCmd = 'cmd.exe /c cd /d "' + appDir + '" && npm run dev';
            shell.Run(startCmd, 0, false);

            startPolling();
        } catch(e) {
            updateStatus("stopped", "Failed to start server: " + e.message);
        }
    }

    function startPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(function() {
            pollAttempts++;
            if (checkHttp()) {
                clearInterval(pollTimer);
                onServerReady();
                if (!browserAlreadyOpened) {
                    browserAlreadyOpened = true;
                    openBrowser();
                }
            } else {
                var dots = new Array((pollAttempts % 4) + 1).join(".");
                updateStatus("starting", "Starting RTBI Portal on port 3030" + dots + " (" + pollAttempts + "s)");
                if (pollAttempts >= maxPollAttempts) {
                    clearInterval(pollTimer);
                    updateStatus("stopped", "Server startup took longer than expected. Click 'Start Server' to try again.");
                }
            }
        }, 1000);
    }

    function onServerReady() {
        updateStatus("running", "RTBI Portal is running and ready at http://localhost:3030");
    }

    function openBrowser() {
        if (!shell) return;
        try {
            shell.Run("http://localhost:3030");
        } catch(e) {
            alert("Could not open browser automatically: " + e.message);
        }
    }

    function toggleServer() {
        if (isRunning) {
            stopServer();
        } else {
            startServerProcess();
        }
    }

    function stopServer() {
        if (pollTimer) clearInterval(pollTimer);
        updateStatus("stopped", "Stopping server process...");
        try {
            var killCmd = 'powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $p = (Get-NetTCPConnection -LocalPort 3030 -State Listen -ErrorAction Stop).OwningProcess; Stop-Process -Id $p -Force } catch {}; exit 0"';
            shell.Run(killCmd, 0, true);
            updateStatus("stopped", "Server stopped. Click 'Start Server' to launch again.");
        } catch(e) {
            updateStatus("stopped", "Error stopping server: " + e.message);
        }
    }

    function restartServer() {
        stopServer();
        setTimeout(function() {
            startServerProcess();
        }, 1000);
    }

    function wipeData() {
        if (!confirm("WARNING: Are you sure you want to completely wipe all application memory and database collections?\n\nThis will purge all members, events, tasks, uploads, and sessions so you can start fresh.")) {
            return;
        }
        try {
            updateStatus("stopped", "Purging database and memory collections...");
            var wipeCmd = 'cmd.exe /c cd /d "' + appDir + '" && node scripts/wipe-data.js';
            shell.Run(wipeCmd, 0, true);
            updateStatus("stopped", "Application data wiped clean. Fresh setup ready at /setup.");
            alert("All application memory and data have been wiped clean.\nNext startup will prompt for initial Super User setup.");
        } catch(e) {
            alert("Error wiping data: " + e.message);
        }
    }
</script>
</body>
</html>
